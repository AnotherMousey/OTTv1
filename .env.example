# Copy to .env and fill in, then: docker compose up -d --build

# Absolute path on this server for compiled bots (created if missing). To bring over an old
# data/db.json, put it in this folder before the first start: it is imported into PostgreSQL.
HOST_DATA_DIR=/srv/ottv1/data

# Password of the PostgreSQL user (only used between the containers; pick something long).
POSTGRES_PASSWORD=change-me-to-something-long

# Password for the "judge" account created on the first start (empty = random, printed in the log).
JUDGE_PASSWORD=

# Port the site is served on.
PORT=3000

# Optional: matches played at the same time (default: half the CPUs), and how long a daily
# brawl's results stay hidden (ms).
# PARALLEL_MATCHES=4
# PUBLISH_DELAY_MS=600000
